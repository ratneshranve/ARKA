# ── App ───────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=5000
# Public site URL, used in emails and password-reset links
APP_URL=http://localhost:5173
# Comma-separated. Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173
# 1 when running behind Nginx
TRUST_PROXY=1

# ── Database ──────────────────────────────────────
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arka_solar?retryWrites=true&w=majority
MONGODB_URI=

# ── Auth ──────────────────────────────────────────
# Two different random strings, at least 32 characters each. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
PASSWORD_RESET_EXPIRES_MIN=30
# true in production (HTTPS)
COOKIE_SECURE=false

# ── Seed admin (used only by `npm run seed:admin`) ──
# Password: at least 8 characters with a letter and a number
ADMIN_NAME=Site Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder; subfolders: products, projects, banners, site
CLOUDINARY_FOLDER=arka-solar

# ── SMTP ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=ARKA Solar Energy
MAIL_FROM_EMAIL=
# Fallback when no notification emails are set in Admin > Site Settings
ENQUIRY_NOTIFY_EMAIL=

# ── Limits ────────────────────────────────────────
UPLOAD_MAX_MB=5
